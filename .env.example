# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git, so your keys stay private.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google AI Studio -> Get API key (free). Server-only, never shared with the browser.
GEMINI_API_KEY=your-gemini-api-key

# Supabase -> Project Settings -> API Keys -> secret / service_role key.
# SECRET: full database access. Server-only (used by the payment webhook).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lemon Squeezy (payments, test mode) -> Settings -> API / Stores / Webhooks
LEMONSQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_ID=67890
LEMONSQUEEZY_WEBHOOK_SECRET=a-long-random-text-you-choose
